root ::= object
object ::= "{" ws "\"ok\"" ws ":" ws boolean ws "," ws "\"formal_writing_result\"" ws ":" ws value ws "}"
value ::= object-generic | array | string | number | boolean | "null"
object-generic ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
array ::= "[" ws (value (ws "," ws value)*)? ws "]"
string ::= "\"" chars "\""
chars ::= ([^"\\] | "\\" ["\\/bfnrt])*
number ::= "-"? [0-9]+ ("." [0-9]+)?
boolean ::= "true" | "false"
ws ::= [ \t\n\r]*
