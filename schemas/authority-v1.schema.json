{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ourd/authority-v1.schema.json",
  "title": "OURD Authority Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "source_snapshot_hash",
    "allowed_paths",
    "forbidden_paths",
    "read_capabilities",
    "command_capabilities",
    "max_retries_per_action",
    "max_automatic_risk",
    "allow_l1_auto_apply",
    "allow_interactive_l2",
    "allow_yolo",
    "mandatory_tests",
    "mandatory_evidence",
    "expires_at",
    "operator",
    "read_only"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "source_snapshot_hash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "read_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "command_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "semantic_capability_ceiling": {"enum": ["C0", "C1", "C2", "C3", "C4", "C5"]},
    "semantic_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "max_retries_per_action": {"type": "integer", "minimum": 0, "maximum": 10},
    "max_automatic_risk": {"enum": ["L0", "L1", "L2"]},
    "allow_l1_auto_apply": {"type": "boolean"},
    "allow_interactive_l2": {"type": "boolean"},
    "allow_yolo": {"type": "boolean"},
    "mandatory_tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mandatory_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expires_at": {"type": "string"},
    "operator": {"type": "string", "minLength": 1},
    "read_only": {"type": "boolean"}
  }
}
